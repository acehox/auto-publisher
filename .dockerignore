# Patterns match the whole context-relative path, so `**/` is what reaches
# nested directories — apps/web/.next (479MB), nested node_modules, packages/*/dist.

# Dependencies
**/node_modules
npm-debug.log
yarn-error.log

# Build outputs
**/dist/
**/build/
**/.next/
**/.turbo/
**/*.tsbuildinfo

# Environment files
.env
.env.*
.env.local
.env.development

# Logs
**/logs/
**/*.log

# IDE and editors
**/.vscode/
**/.idea/
**/*.swp
**/*.swo

# OS files
**/.DS_Store
**/Thumbs.db

# Temporary files
**/tmp/
**/temp/
**/.tmp/
**/*.tmp
**/*.temp

# Git
.git/
.gitignore

# Documentation. Note `*.md` deliberately does NOT match the dashboard's `.mdx`
# route files (legal pages) — those must reach the web build.
**/*.md
CHANGELOG.md
LICENSE

# CI/CD
.github/
.gitlab-ci.yml

# Docker related
**/Dockerfile
**/docker-compose*.yml
.dockerignore

# Test coverage
**/coverage/

# Development scripts (not needed in containers)
scripts/

# Scraped documentation cache
.firecrawl/

# Supabase
supabase/.branches
supabase/.temp
