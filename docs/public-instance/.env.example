# Auto Publisher — PUBLIC INSTANCE configuration
#
# Self-hosters do NOT need any of this. See `.env.example` at the repo root
# and docs/self-hosting.md.
#
# ---------------------------------------------------------------------------
DEPLOYMENT_MODE = "public"

# --- The bot ----------------------------------------------------------------
# One bot serves every guild; Free and Premium are per-guild subscription
# tiers. Use the LONG-LIVED application the existing servers already have —
# Discord has no way for a bot to move servers between applications, so
# switching means every server re-inviting (ADR 0013).
DISCORD_BOT_TOKEN = ""

# Proxy base URL (compose service name; override only for a custom topology)
PROXY_URL = "http://proxy:8080"

# Outbound source IP for Discord traffic. Discord's invalid-request ceiling is
# per IP, so this is the address to rotate if the proxy's self-shed ever trips
# for real. Empty = default route.
EGRESS_LOCAL_ADDRESS = ""

# --- Backend ----------------------------------------------------------------
DATABASE_URL = "postgresql://postgres:postgres@host.docker.internal:54322/postgres"
WEB_APP_ORIGIN = "https://auto-publisher.gg"

# --- Bot --------------------------------------------------------------------
BOT_SHARDS = 1
BOT_SHARDS_PER_CLUSTER = 1
# Guild that the bot-admin commands are registered to. Unset = not registered.
BOT_SUPPORT_GUILD_ID = "958709555683033128"

# --- Dashboard --------------------------------------------------------------
# The OAuth application users log in with, plus the application id of the bot
# they are invited to. Set DISCORD_BOT_ID only when the bot is a DIFFERENT
# application than the login client — which it is here, because the bot is the
# long-lived one the existing servers already have. It defaults to
# DISCORD_CLIENT_ID, which is what a self-host relies on.
AUTH_SECRET = ""
DISCORD_CLIENT_ID = ""
DISCORD_CLIENT_SECRET = ""
DISCORD_BOT_ID = ""

# Where the dashboard reaches the backend, server-side only — never from the
# browser.
BACKEND_URL = "http://backend:8080"

# --- Alerts (optional; disabled when unset) ---------------------------------
DISCORD_ALERT_WEBHOOK_URL = ""

# --- Paddle -----------------------------------------------------------------
PADDLE_ENVIRONMENT = "sandbox"             # "sandbox" or "production"
PADDLE_CLIENT_TOKEN = ""                   # test_... / live_...
PADDLE_API_KEY = ""                        # pdl_sdbx_apikey_... / pdl_live_apikey_...
PADDLE_WEBHOOK_SECRET = ""                 # pdl_ntfset_... from the notification destination
PADDLE_PRICE_ID_MONTHLY = ""               # pri_...
PADDLE_PRICE_ID_MONTHLY_TRIAL = ""         # pri_...
PADDLE_PRICE_ID_YEARLY = ""                # pri_...
PADDLE_PRICE_ID_YEARLY_TRIAL = ""          # pri_...

# --- Outbound email ---------------------------------------------------------
# The statutory withdrawal acknowledgement (ZZP čl. 81.a st. 6) is the only
# mail the stack sends. Empty credentials disable sending, which surfaces as a
# failed acknowledgement and an alert — never a silent no-op.
# Real provider only: local dev is served by the Mailpit service in the dev
# compose overlay, which sets these itself.
SMTP_HOST = "smtp.zoho.eu"
SMTP_PORT = "465"                       # 465 = implicit TLS; 587 negotiates STARTTLS
SMTP_USER = ""
SMTP_PASSWORD = ""
SMTP_FROM = "Auto Publisher <support@auto-publisher.gg>"
