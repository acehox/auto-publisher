#!/bin/bash

# Local branch names are free (Orca names them); only Conventional Commits names reach GitHub.

TYPES="build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test"
ZERO="0000000000000000000000000000000000000000"
STATUS=0

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ "$LOCAL_SHA" = "$ZERO" ] && continue
  case "$REMOTE_REF" in
    refs/heads/*) BRANCH="${REMOTE_REF#refs/heads/}" ;;
    *) continue ;;
  esac

  if [[ "$BRANCH" =~ ^(main|develop)$ || "$BRANCH" =~ ^($TYPES)/[a-z0-9][a-z0-9._-]*$ ]]; then
    continue
  fi

  NAME="${BRANCH##*/}"
  SUGGESTION="feat/$NAME"
  [[ "$NAME" =~ ^($TYPES)-(.+)$ ]] && SUGGESTION="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"

  echo "❌ Push refused: '$BRANCH' is not <type>/<name> ($TYPES)." >&2
  echo "   Rename it first, for example: git branch -m '$BRANCH' '$SUGGESTION'" >&2
  STATUS=1
done

exit $STATUS
